{
  "name": "boomex-web-android-validation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "build:telegram-preview": "node scripts/build-telegram-preview.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "sync:android": "npm run build:web && cap sync android",
    "build:android:debug": "npm run build:web && cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "node scripts/build-release.mjs",
    "build:android:unsigned": "node scripts/build-android-unsigned.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.28.2"
  }
}
